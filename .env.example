# Local-only defaults. Copy to .env before starting the services.
APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://postgres.[project-ref]:[encoded-password]@[pooler-host]:5432/postgres
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-key
STORAGE_DIR=./storage
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=168
MAX_UPLOAD_BYTES=10485760
MAX_VIDEO_BYTES=52428800
MAX_VIDEO_SECONDS=300
MAX_IMAGE_PIXELS=40000000
UPLOAD_RETENTION_DAYS=0
# Guest ownership uses a signed cookie; APP_SECRET_KEY is its HMAC key.
GUEST_COOKIE_NAME=cgs_guest
GUEST_COOKIE_TTL_DAYS=365
# Only trust X-Forwarded-For when the direct peer is in one of these configured CIDRs.
TRUSTED_PROXY_CIDRS=
MAX_ACCOUNTS_PER_IP=3
IP_ACCOUNT_WINDOW_DAYS=0
IP_BLOCK_MODE=soft
SUPPORT_CONTACT_EMAIL=
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
DISPOSABLE_EMAIL_DOMAINS=mailinator.com,tempmail.com,10minutemail.com
PUBLIC_APP_ORIGIN=http://127.0.0.1:3000
# Configure SMTP in deployments so verification and reset links can be delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
# Optional comma-separated bootstrap admin addresses; do not expose this list publicly.
ADMIN_EMAILS=
# Required for the administrator sign-in page. run.ps1 generates a 256-bit URL-safe slug if this is blank.
ADMIN_LOGIN_SLUG=
APP_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
NEXT_API_ORIGIN=http://127.0.0.1:8000
AI_DETECTOR_PROVIDER=local
AI_MODEL_PATH=./models/community_forensics_low_quality_fp16.onnx
INFERENCE_CPU_THREADS=2
INFERENCE_MAX_ATTEMPTS=3
INFERENCE_LEASE_SECONDS=1800
WORKER_POLL_SECONDS=1
RATE_LIMIT_AUTH_LIMIT=12
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_IDENTITY_LIMIT=12
RATE_LIMIT_UPLOAD_LIMIT=30
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=3600
RATE_LIMIT_ANALYSIS_OWNER_LIMIT=12
RATE_LIMIT_ANALYSIS_IP_LIMIT=30
RATE_LIMIT_ANALYSIS_WINDOW_SECONDS=3600
RATE_LIMIT_SUPPORT_LIMIT=3
# Docker Compose only: use long random hexadecimal passwords, separate per role.
POSTGRES_PASSWORD=local-dev-only-change-me
APP_DB_PASSWORD=replace-with-a-random-app-database-password
MIGRATOR_DB_PASSWORD=replace-with-a-different-random-migration-database-password

